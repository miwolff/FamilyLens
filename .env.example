# Path to your primary photos folder (absolute path)
PHOTOS_DIR=/path/to/your/photos

# Optional: up to 4 additional photo directories (absolute paths).
# Each photo directory is mounted under /photos/N inside the container
# and is scanned automatically when indexing.
# Leave commented out (or remove) if you only have one photos directory.
#PHOTOS_DIR_2=/path/to/second/photos
#PHOTOS_DIR_3=/path/to/third/photos
#PHOTOS_DIR_4=/path/to/fourth/photos
#PHOTOS_DIR_5=/path/to/fifth/photos
